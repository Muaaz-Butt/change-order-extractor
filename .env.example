# Copy this file to .env and fill in ONE key:   cp .env.example .env
# .env is git-ignored, so your key never gets committed.

# Gemini (has a free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude. Get a key at https://console.anthropic.com/settings/keys
# If both keys are set, --provider auto uses Claude.
# ANTHROPIC_API_KEY=

# Optional settings
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash
# GEMINI_TIMEOUT_MS=60000
# CO_EXTRACT_MODEL=claude-opus-5-5
